{
  "name": "scentuary",
  "version": "0.1.0",
  "description": "A pinned, scroll-driven descent through a fragrance's notes — the page holds still while each note blooms in its own tone, a thread draws downward, and the field recolours. React.",
  "author": "Sajad Abdolvandi",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "perfume",
    "fragrance",
    "scent",
    "perfumery",
    "react",
    "gsap",
    "scroll",
    "scrollytelling",
    "animation",
    "notes"
  ],
  "peerDependencies": {
    "gsap": ">=3.13",
    "motion": ">=11",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "gsap": "^3.13.0",
    "motion": "^12.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realdeal88/scentuary.git"
  },
  "homepage": "https://github.com/realdeal88/scentuary#readme",
  "bugs": {
    "url": "https://github.com/realdeal88/scentuary/issues"
  }
}
